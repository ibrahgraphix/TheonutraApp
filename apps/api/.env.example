# -------------------------------------------------------
# Theonutra API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development

# Supabase — use the SECRET key (sb_secret_...) here, NOT the publishable key.
# This backend is the only consumer of the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# JWKS endpoint for asymmetric JWT verification.
# Found in Supabase dashboard → Settings → API → JWKS URL.
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Internal email domain used to synthesise Supabase Auth emails from Distributor IDs.
# e.g. a Distributor ID of "BF-TZ-00231" becomes "bf-tz-00231@theonutra.internal"
# Change this to match your actual internal domain (never exposed to sellers).
INTERNAL_EMAIL_DOMAIN=theonutra.internal

# Commission rates per upline level (comma-separated, level 1 first).
# e.g. "0.05,0.03,0.02" means 5% for direct upline, 3% for level-2, 2% for level-3.
COMMISSION_RATES=0.05,0.03,0.02

# Flat commission percentage for direct recruiter (level 1 only).
# ⚠️ IMPORTANT: This value MUST be confirmed with the client before going live.
# Currently set to 10% as a placeholder - adjust based on business agreement.
COMMISSION_PERCENTAGE=10
