{
  "expo": {
    "name": "Theonutra",
    "slug": "theonutra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "extra": {
      "apiUrl": "https://theonutraapp-backend.onrender.com"
    },
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theonutra.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A5E3A",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.theonutra.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Theonutra to access your photos to upload product images."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
