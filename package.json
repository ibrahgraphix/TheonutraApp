{
  "name": "theonutra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm -w mobile run start",
    "dev:api": "npm -w api run dev",
    "dev": "powershell -NoProfile -Command \"Start-Process powershell -ArgumentList 'npm run dev:api'; npm run dev:mobile\""
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "expo-clipboard": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "react-native-image-picker": "^8.2.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "15.15.4"
  }
}
